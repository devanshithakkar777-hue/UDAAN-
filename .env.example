# ---- Required ----
# Postgres connection string (use SSL in production, e.g. ?sslmode=require)
DATABASE_URL=postgres://user:password@host:5432/udaan
# 32 random bytes, base64. Generate: openssl rand -base64 32
# LOSING THIS KEY MAKES ALL ENCRYPTED USER DATA UNREADABLE. Back it up in a secrets manager.
DATA_ENCRYPTION_KEY=
# Random salt used to hash IP addresses. Generate: openssl rand -hex 16
IP_HASH_SALT=
# Public URL of the app, used for origin checks (no trailing slash)
APP_URL=https://app.example.com
# Secret for the cron endpoint (reminders). Generate: openssl rand -hex 16
CRON_SECRET=

# ---- AI ----
# anthropic | groq | mock (mock is development only; refused in production)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Companion model and a fast model for the safety classifier. Admin can override at runtime.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-5-5
# Free alternative: AI_PROVIDER=groq with a free key from console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CLASSIFIER_MODEL=llama-3.1-8b-instant

# ---- Optional ----
# Email of the first admin; that account becomes admin on signup
ADMIN_BOOTSTRAP_EMAIL=
# Web push for reminders and check-ins. Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
# Set true only after you have verified every crisis helpline in src/safety/resources.ts
CRISIS_RESOURCES_VERIFIED=false
# Test database for npm test
DATABASE_URL_TEST=postgres://user:password@localhost:5432/udaan_test
